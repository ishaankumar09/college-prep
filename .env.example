# ——— Map tiles ———
# Stadia Maps API key — required for any non-localhost deploy (tiles 401 otherwise).
# Free key: https://client.stadiamaps.com  (account → property → API key)
NEXT_PUBLIC_STADIA_API_KEY=

# ——— Checklist backend ———
# Upstash Redis (free tier) — required on Netlify/Vercel so tasks persist.
# Create a database at https://console.upstash.com and copy the REST URL + token.
# (The Vercel Marketplace Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead — both work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# REQUIRED — the checklist edit passcode. Not stored anywhere in the code.
# Locally: put it in .env.local (gitignored). Deployed: add it to the host env settings.
# Editing stays disabled (with a warning on the page) until this is set.
CHECKLIST_PASSCODE=
